{{!
    This file is part of Moodle - http://moodle.org/

    @template    block_feedback_tracker/drilldown

    Pending-submissions drilldown table.

    Context variables required:
    * heading       Page heading text
    * empty         Truthy when no submitted-but-ungraded submissions match the filter
    * emptytext     Empty-state message
    * cols          {student, activity, group, submitted, waiting, effective, status}
    * rows          Array of {student, activity, group, submitted, waiting, effective, status, bucket,
                    resubmitted, resubmittedtip, markingline}: status is the band's localised label,
                    bucket its slug (the badge class); resubmitted marks work handed in again after a
                    mark, explained by resubmittedtip; markingline is the multi-marker progress
                    ("1 of 2 markers", "Awaiting agreed grade"), empty when there is none
    * resubmittedlabel  Text of the Resubmitted badge
    * pagingbar     Pre-rendered paging-bar HTML (raw)
    * hasdrafts     Truthy when there is at least one draft (not-yet-submitted) row
    * draftheading  Heading for the drafts section
    * draftnote     Explanatory note for the drafts section
    * draftbadge    Label for the per-row draft badge
    * draftcols     {student, activity, group, lastsaved, status}
    * draftrows     Array of {student, activity, group, lastsaved, lastsavedts}
    * hasmarkers    Truthy when the per-marker section is shown (multi-marking rows in scope and a
                    viewer allowed to manage marker allocations)
    * markerheading Heading for the per-marker section
    * markernote    Explanatory note for the per-marker section
    * markercols    {marker, open, completed, median, coverage}
    * markerrows    Array of {name, open, completed, median, coverage}: the counts are formatted,
                    median is the marker's own median turnaround in the display unit, coverage a
                    percentage; "-" stands for no value

    Example context (json):
    {
        "heading": "Pending submissions",
        "empty": false,
        "emptytext": "No pending submissions.",
        "cols": {
            "student": "Student", "activity": "Activity", "group": "Group",
            "submitted": "Submitted", "waiting": "Waiting", "effective": "Effective",
            "status": "Status"
        },
        "rows": [
            {
                "student": "Ana Silva", "activity": "Class log 3", "group": "Class A",
                "submitted": "2026-05-16 09:14", "submittedts": 1747380840,
                "waiting": "27.0 h", "waitingnum": 27.0,
                "effective": "16.0 h", "effectivenum": 16.0,
                "status": "Good", "bucket": "good",
                "resubmitted": true,
                "resubmittedtip": "This attempt was already marked on 12 May 2026 when the student saved the submission again.",
                "markingline": "1 of 2 markers"
            }
        ],
        "resubmittedlabel": "Resubmitted",
        "pagingbar": "",
        "hasdrafts": true,
        "draftheading": "Not yet submitted",
        "draftnote": "Drafts aren't counted toward responsiveness.",
        "draftbadge": "Draft",
        "draftcols": {
            "student": "Student", "activity": "Activity", "group": "Group",
            "lastsaved": "Last saved", "status": "Status"
        },
        "draftrows": [
            {
                "student": "Bruno Costa", "activity": "Class log 3", "group": "Class A",
                "lastsaved": "2026-05-18 21:02", "lastsavedts": 1747602120
            }
        ],
        "hasmarkers": true,
        "markerheading": "Markers",
        "markernote": "Each marker's own turnaround runs from the moment they became responsible to their own Marking completed.",
        "markercols": {
            "marker": "Marker", "open": "Open slots", "completed": "Marks completed",
            "median": "Median own turnaround", "coverage": "Coverage"
        },
        "markerrows": [
            {"name": "Carla Souza", "open": "2", "completed": "14", "median": "9.5 h", "coverage": "93%"},
            {"name": "Diego Lima", "open": "0", "completed": "0", "median": "-", "coverage": "-"}
        ]
    }
}}
<h2>{{heading}}</h2>
{{#empty}}
    <div class="alert alert-info">{{emptytext}}</div>
{{/empty}}
{{^empty}}
    <table class="generaltable bft-sortable">
        <thead>
            <tr>
                <th scope="col" data-sort="text" aria-sort="none">
                    <button type="button" class="bft-th-sortable-btn">{{cols.student}}</button>
                </th>
                <th scope="col" data-sort="text" aria-sort="none">
                    <button type="button" class="bft-th-sortable-btn">{{cols.activity}}</button>
                </th>
                <th scope="col" data-sort="text" aria-sort="none">
                    <button type="button" class="bft-th-sortable-btn">{{cols.group}}</button>
                </th>
                <th scope="col" data-sort="num" aria-sort="none">
                    <button type="button" class="bft-th-sortable-btn">{{cols.submitted}}</button>
                </th>
                <th scope="col" data-sort="num" aria-sort="none">
                    <button type="button" class="bft-th-sortable-btn">{{cols.waiting}}</button>
                </th>
                <th scope="col" data-sort="num" aria-sort="none">
                    <button type="button" class="bft-th-sortable-btn">{{cols.effective}}</button>
                </th>
                <th scope="col" data-sort="text" aria-sort="none">
                    <button type="button" class="bft-th-sortable-btn">{{cols.status}}</button>
                </th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}
                <tr>
                    <td>{{student}}</td>
                    <td>{{activity}}</td>
                    <td>{{group}}</td>
                    <td data-sort-value="{{submittedts}}">{{submitted}}</td>
                    <td data-sort-value="{{waitingnum}}">{{waiting}}</td>
                    <td data-sort-value="{{effectivenum}}">{{effective}}</td>
                    <td data-sort-value="{{status}}">
                        <span class="badge badge-{{bucket}}">{{status}}</span>
                        {{#resubmitted}}
                            <span class="badge bft-badge-resubmitted" title="{{resubmittedtip}}">{{resubmittedlabel}}</span>
                            <span class="bft-sr-only">{{resubmittedtip}}</span>
                        {{/resubmitted}}
                        {{#markingline}}
                            <span class="bft-row-marking">{{markingline}}</span>
                        {{/markingline}}
                    </td>
                </tr>
            {{/rows}}
        </tbody>
    </table>
    {{{pagingbar}}}
{{/empty}}
{{#hasdrafts}}
    <div class="bft-drilldown-drafts">
        <h3>{{draftheading}}</h3>
        <p class="bft-drilldown-drafts-note">{{draftnote}}</p>
        <table class="generaltable bft-drilldown-drafts-table">
            <thead>
                <tr>
                    <th>{{draftcols.student}}</th>
                    <th>{{draftcols.activity}}</th>
                    <th>{{draftcols.group}}</th>
                    <th>{{draftcols.lastsaved}}</th>
                    <th>{{draftcols.status}}</th>
                </tr>
            </thead>
            <tbody>
                {{#draftrows}}
                    <tr class="bft-row-draft">
                        <td>{{student}}</td>
                        <td>{{activity}}</td>
                        <td>{{group}}</td>
                        <td>{{lastsaved}}</td>
                        <td><span class="badge badge-draft">{{draftbadge}}</span></td>
                    </tr>
                {{/draftrows}}
            </tbody>
        </table>
    </div>
{{/hasdrafts}}
{{#hasmarkers}}
    <div class="bft-drilldown-markers">
        <h3>{{markerheading}}</h3>
        <p class="bft-drilldown-markers-note">{{markernote}}</p>
        <table class="generaltable bft-drilldown-markers-table">
            <thead>
                <tr>
                    <th scope="col">{{markercols.marker}}</th>
                    <th scope="col">{{markercols.open}}</th>
                    <th scope="col">{{markercols.completed}}</th>
                    <th scope="col">{{markercols.median}}</th>
                    <th scope="col">{{markercols.coverage}}</th>
                </tr>
            </thead>
            <tbody>
                {{#markerrows}}
                    <tr>
                        <td>{{name}}</td>
                        <td>{{open}}</td>
                        <td>{{completed}}</td>
                        <td>{{median}}</td>
                        <td>{{coverage}}</td>
                    </tr>
                {{/markerrows}}
            </tbody>
        </table>
    </div>
{{/hasmarkers}}
